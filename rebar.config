% -*- mode: erlang; -*- vim: set ft=erlang:

%% == Erlang Compiler == %%

% but only 24+ is supported
{minimum_otp_vsn, "22"}.

{erl_opts, [
    debug_info,
    warn_export_vars,
    %warn_missing_spec,
    warn_unused_import,
    %warnings_as_errors,
    % EEP-48 doc attributes (OTP 27+)
    {platform_define, "^2[7-9]\\.", 'E48'},
    {platform_define, "^[3-9]", 'E48'}
]}.

%% == Dependencies and plugins ==

{deps, [
    {xb5, "~> 1.0"}
]}.

{project_plugins, [
    {erlfmt, "~> 1.7"},
    % excluded on older OTP versions (see rebar.config.script)
    {rebar3_hank, "~> 1.6"},
    {rebar3_hex, "~> 7.1"},
    % excluded on older OTP versions (see rebar.config.script)
    {rebar3_lint, "~> 5.0"}
]}.

%% == C code ==

{pre_hooks, [
    {"(linux|darwin|solaris)", compile, "make -C c_src"},
    {"(freebsd)", compile, "gmake -C c_src"},
    % matches e.g. "28-x86_64-pc-windows-64"
    {"windows", compile, "cd c_src && nmake /nologo /f Makefile.win"}
]}.
{post_hooks, [
    {"(linux|darwin|solaris)", clean, "make -C c_src clean"},
    {"(freebsd)", clean, "gmake -C c_src clean"},
    {"windows", clean, "cd c_src && nmake /nologo /f Makefile.win clean"}
]}.

%% == Formatter ==

{erlfmt, [
    write,
    {files, [
        "elvis.config",
        "ex_doc.config",
        "rebar.config",
        "shell.config",
        "{src,test}/*.{hrl,erl}"
    ]}
]}.

%% == Dialyzer ==

{dialyzer, [
    {warnings, [
        error_handling,
        underspecs,
        unknown,
        unmatched_returns
    ]},
    {plt_extra_apps, [
        common_test
    ]}
]}.

%% == Xref ==

{xref_checks, [
    deprecated_function_calls,
    exports_not_used,
    locals_not_used,
    undefined_function_calls
]}.

%% == Profiles ==

{profiles, [
    {shell, [
        {erl_opts, [
            nowarn_missing_spec,
            nowarnings_as_errors
        ]},
        {shell, [
            {apps, [cbroker]},
            {config, "shell.config"}
        ]}
    ]},

    {test, [
        {erl_opts, [
            debug_info,
            nowarn_export_all,
            nowarn_missing_spec,
            nowarnings_as_errors
        ]},
        {cover_enabled, true},
        {cover_opts, [verbose]},
        % FIXME
        % Cover-compiling reloads the module while its NIF library is loaded,
        % which ERTS treats as a NIF upgrade, and the library has no upgrade
        % callback. On OTP 24-26 the failure then hangs the cover analysis.
        {cover_excl_mods, [cbroker]}
    ]}
]}.

%% == Hank ==

{hank, [
    {ignore, [
        "test/**"
    ]}
]}.

%% == Docs ==

% Necessary for ExDoc.

{edoc_opts, [
    {preprocess, true},
    {doclet, edoc_doclet_chunks},
    {layout, edoc_layout_chunks},
    {dir, "_build/docs/lib/cbroker/doc"}
]}.
