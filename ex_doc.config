% -*- mode: erlang; -*- vim: set ft=erlang:

{prefix_ref_vsn_with_v, false}.
{source_url, <<"https://github.com/g-andrade/cbroker">>}.
{extras, [<<"README.md">>, <<"INTERNALS.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]}.
{main, <<"readme">>}.
{proglang, erlang}.
% Renders ```mermaid blocks; ex_doc emits them as <pre><code class="mermaid">.
{before_closing_body_tag, #{
    html =>
        <<
            "<script src=\"https://cdn.jsdelivr.net/npm/mermaid@12.0.0/dist/mermaid.min.js\"></script>\n"
            "<script>\n"
            "  let mermaidId = 0;\n"
            "  window.addEventListener(\"exdoc:loaded\", () => {\n"
            "    mermaid.initialize({\n"
            "      startOnLoad: false,\n"
            "      theme: document.body.classList.contains(\"dark\") ? \"dark\" : \"default\"\n"
            "    });\n"
            "    for (const codeEl of document.querySelectorAll(\"pre code.mermaid\")) {\n"
            "      const preEl = codeEl.parentElement;\n"
            "      mermaid.render(\"mermaid-\" + mermaidId++, codeEl.textContent).then(({svg}) => {\n"
            "        const graphEl = document.createElement(\"div\");\n"
            "        graphEl.innerHTML = svg;\n"
            "        preEl.replaceWith(graphEl);\n"
            "      });\n"
            "    }\n"
            "  });\n"
            "</script>\n"
        >>
}}.
